import { Button, CheckBox, ComboBox, LineEdit, Slider, Switch, ScrollView, Palette } from "std-widgets.slint";
export { Palette }

export struct TileItem { x: length, y: length, size: length, image: image }
export struct PlaneItem { x: length, y: length, heading: float, color: color, ground: bool, selected: bool, emergency: bool }
export struct KV { k: string, v: string }

/// Colour presets. `variant`: 0 light, 1 dark, 2 midnight, 3 sepia, 4 high contrast.
/// Set from Rust together with `Palette.color-scheme`, so the std-widgets always
/// use a matching light/dark scheme (otherwise text can end up white on white).
export global AppTheme {
    in property <int> variant: 0;
    out property <bool> dark: variant == 1 || variant == 2;
    pure function pick(light: color, dark: color, midnight: color, sepia: color, hc: color) -> color {
        variant == 1 ? dark : variant == 2 ? midnight : variant == 3 ? sepia : variant == 4 ? hc : light
    }
    out property <color> panel: pick(#fffffff0, #1b2229f0, #0d1630f2, #f7f0e1f2, #ffffff);
    out property <color> text: pick(#1a2128, #e8edf2, #e6ecff, #3b2f22, #000000);
    out property <color> muted: pick(#5b6773, #9aa7b4, #8fa0c8, #7a6650, #1f1f1f);
    out property <color> ocean: pick(#cde4f2, #10202c, #050b1c, #e6dcc6, #ffffff);
    out property <color> coast: pick(#5f7487, #7f98ae, #4f6fa8, #8a7353, #000000);
    out property <color> border: pick(#a3b2c0, #43566a, #26365e, #c9b896, #000000);
    out property <color> bar: pick(#f1f4f7, #151b21, #08101f, #efe6d2, #ffffff);
    out property <color> accent: pick(#3b82f6, #3b82f6, #22d3ee, #b45309, #0047ff);
    out property <color> danger: variant == 4 ? #d00000 : #ef4444;
    /// Overlay drawn over the (always light) map tiles to match the theme.
    out property <color> tile-tint: pick(transparent, #0a0f14.with-alpha(0.38), #020a24.with-alpha(0.45), #7a4a12.with-alpha(0.14), transparent);
    out property <length> border-width: variant == 4 ? 2px : 1px;
}

component Panel inherits Rectangle {
    background: AppTheme.panel;
    border-radius: 8px;
    border-width: AppTheme.border-width;
    border-color: AppTheme.border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000040;
}

component MapButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: ta.has-hover ? AppTheme.accent.with-alpha(0.25) : AppTheme.panel;
    border-width: 1px;
    border-color: AppTheme.border;
    Text { text: root.label; color: AppTheme.text; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text { text: root.label; color: AppTheme.muted; width: 120px; vertical-alignment: center; font-size: 12px; }
    @children
}

export component MainWindow inherits Window {
    title: "skytrace";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 760px;
    min-height: 520px;
    background: AppTheme.bar;
    default-font-size: 13px;

    // ---- map data (set from Rust)
    in property <[TileItem]> tiles;
    in property <[PlaneItem]> planes;
    in property <string> coast-path;
    in property <string> border-path;
    in property <string> trail-path;
    in property <bool> basemap-visible: true;
    in property <string> hover-text;
    in property <length> hover-x;
    in property <length> hover-y;
    in property <bool> hovering;
    in property <string> attribution;
    in property <[string]> legend-labels;
    in property <string> legend-title;
    in property <string> alert-text;
    // ---- panel
    in property <bool> has-selection;
    in property <string> panel-title;
    in property <string> panel-subtitle;
    in property <bool> panel-emergency;
    in property <[KV]> panel-rows;
    in-out property <bool> follow;
    // ---- stats bar
    in property <string> stats-text;
    in property <string> status-text;
    in property <bool> status-ok;
    // ---- search / filters
    in-out property <string> search-text;
    in-out property <bool> filters-open;
    in-out property <string> f-min-alt;
    in-out property <string> f-max-alt;
    in-out property <bool> f-ground;
    in-out property <bool> f-mil;
    in-out property <string> f-type;
    in property <string> alt-unit: "ft";
    // ---- settings
    in-out property <bool> settings-open;
    in-out property <float> s-poll: 5;
    in-out property <int> s-units;
    in-out property <int> s-theme;
    in-out property <int> s-source;
    in-out property <bool> s-opensky;
    in-out property <float> s-preload: 250;
    in-out property <bool> s-adaptive: true;
    in-out property <string> s-tile-url;
    in-out property <string> s-lat;
    in-out property <string> s-lon;
    in property <string> s-error;

    callback map-resized(float, float);
    callback map-down(float, float);
    callback map-up(float, float);
    callback map-move(float, float);
    callback map-scroll(float, float, float);
    callback zoom-in();
    callback zoom-out();
    callback go-home();
    callback search-edited(string);
    callback search-accepted(string);
    callback filters-changed();
    callback follow-toggled(bool);
    callback close-panel();
    callback alert-clicked();
    callback alert-dismissed();
    callback save-settings();
    callback open-settings();
    callback use-center();

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            map := Rectangle {
                vertical-stretch: 1;
                clip: true;
                background: AppTheme.ocean;
                changed width => { root.map-resized(self.width / 1px, self.height / 1px); }
                changed height => { root.map-resized(self.width / 1px, self.height / 1px); }

                // Offline basemap (Natural Earth): only while tiles don't cover the view.
                if root.basemap-visible: Path {
                    width: parent.width; height: parent.height;
                    viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
                    commands: root.border-path;
                    stroke: AppTheme.border; stroke-width: 1px;
                }
                if root.basemap-visible: Path {
                    width: parent.width; height: parent.height;
                    viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
                    commands: root.coast-path;
                    stroke: AppTheme.coast; stroke-width: 1.2px;
                }
                for t in root.tiles: Image {
                    x: t.x; y: t.y; width: t.size; height: t.size;
                    source: t.image;
                }
                Rectangle { background: AppTheme.tile-tint; }
                Path {
                    width: parent.width; height: parent.height;
                    viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
                    commands: root.trail-path;
                    stroke: #ff9f1c; stroke-width: 2px;
                }
                for p in root.planes: Rectangle {
                    x: p.x - 15px; y: p.y - 15px; width: 30px; height: 30px;
                    if p.emergency || p.selected: Rectangle {
                        x: 2px; y: 2px; width: 26px; height: 26px; border-radius: 13px;
                        border-width: 2px;
                        border-color: p.emergency ? AppTheme.danger : white;
                        background: p.emergency ? AppTheme.danger.with-alpha(0.25) : transparent;
                    }
                    if !p.ground: Image {
                        x: 2px; y: 2px; width: 26px; height: 26px;
                        source: @image-url("../assets/plane.svg");
                        colorize: #000000b0;
                        transform-rotation: p.heading * 1deg;
                    }
                    if !p.ground: Image {
                        x: 4px; y: 4px; width: 22px; height: 22px;
                        source: @image-url("../assets/plane.svg");
                        colorize: p.color;
                        transform-rotation: p.heading * 1deg;
                    }
                    if p.ground: Rectangle {
                        x: 10px; y: 10px; width: 10px; height: 10px; border-radius: 2px;
                        background: p.color; border-width: 1px; border-color: #000000a0;
                    }
                }

                TouchArea {
                    mouse-cursor: root.hovering ? MouseCursor.pointer : MouseCursor.default;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            root.map-down(self.mouse-x / 1px, self.mouse-y / 1px);
                        } else if e.kind == PointerEventKind.up {
                            root.map-up(self.mouse-x / 1px, self.mouse-y / 1px);
                        } else if e.kind == PointerEventKind.move {
                            root.map-move(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                    scroll-event(e) => {
                        root.map-scroll(self.mouse-x / 1px, self.mouse-y / 1px, e.delta-y / 1px);
                        accept
                    }
                }

                if root.hover-text != "": Rectangle {
                    x: root.hover-x + 14px; y: root.hover-y - 30px;
                    width: tt.preferred-width + 14px; height: 24px;
                    background: #000000cc; border-radius: 4px;
                    tt := Text { text: root.hover-text; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }

                // top bar: search + filters
                Panel {
                    x: 12px; y: 12px; width: 420px; height: 46px;
                    HorizontalLayout {
                        padding: 6px; spacing: 6px;
                        LineEdit {
                            placeholder-text: "Search callsign, registration, hex";
                            text <=> root.search-text;
                            edited(t) => { root.search-edited(t); }
                            accepted(t) => { root.search-accepted(t); }
                        }
                        Button { text: "Filters"; checkable: true; checked <=> root.filters-open; }
                        Button { text: "⚙"; clicked => { root.open-settings(); } }
                    }
                }
                if root.filters-open: Panel {
                    x: 12px; y: 64px; width: 420px; height: 190px;
                    VerticalLayout {
                        padding: 12px; spacing: 6px;
                        Field {
                            label: "Altitude (" + root.alt-unit + ")";
                            LineEdit { placeholder-text: "min"; text <=> root.f-min-alt; edited(t) => { root.filters-changed(); } }
                            LineEdit { placeholder-text: "max"; text <=> root.f-max-alt; edited(t) => { root.filters-changed(); } }
                        }
                        Field {
                            label: "Aircraft type";
                            LineEdit { placeholder-text: "e.g. B738"; text <=> root.f-type; edited(t) => { root.filters-changed(); } }
                        }
                        CheckBox { text: "Hide aircraft on ground"; checked <=> root.f-ground; toggled => { root.filters-changed(); } }
                        CheckBox { text: "Military only"; checked <=> root.f-mil; toggled => { root.filters-changed(); } }
                    }
                }

                // emergency banner
                if root.alert-text != "": Rectangle {
                    x: (parent.width - self.width) / 2; y: 12px;
                    width: min(parent.width - 520px, 520px); height: 40px;
                    background: AppTheme.danger; border-radius: 8px;
                    drop-shadow-blur: 10px; drop-shadow-color: #00000070;
                    Text { text: root.alert-text; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.alert-clicked(); } }
                    Rectangle {
                        x: parent.width - 32px; y: 8px; width: 24px; height: 24px;
                        Text { text: "✕"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.alert-dismissed(); } }
                    }
                }

                // zoom controls
                VerticalLayout {
                    x: parent.width - 46px; y: 12px; width: 34px; height: 114px; spacing: 6px;
                    MapButton { label: "+"; clicked => { root.zoom-in(); } }
                    MapButton { label: "−"; clicked => { root.zoom-out(); } }
                    MapButton { label: "⌂"; clicked => { root.go-home(); } }
                }

                // legend
                Panel {
                    x: 12px; y: parent.height - 96px; width: 240px; height: 84px;
                    VerticalLayout {
                        padding: 8px; spacing: 4px;
                        Text { text: root.legend-title; color: AppTheme.muted; font-size: 11px; }
                        Rectangle {
                            height: 10px; border-radius: 5px;
                            background: @linear-gradient(90deg, #f5a524 0%, #d4e03c 12.5%, #3ddc84 25%, #20c9c9 50%, #3b82f6 75%, #a855f7 100%);
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            for l in root.legend-labels: Text { text: l; color: AppTheme.text; font-size: 10px; }
                        }
                        Text { text: "▪ on ground    ◯ red = emergency squawk"; color: AppTheme.muted; font-size: 10px; }
                    }
                }

                // attribution (required by OSM / ODbL)
                Rectangle {
                    x: parent.width - self.width; y: parent.height - self.height;
                    width: at.preferred-width + 12px; height: 20px;
                    background: AppTheme.panel;
                    at := Text { text: root.attribution; color: AppTheme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            // stats bar
            Rectangle {
                height: 28px;
                background: AppTheme.bar;
                border-width: 0px;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 14px;
                    Text { text: root.stats-text; color: AppTheme.text; vertical-alignment: center; font-size: 12px; }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 9px; height: 9px; y: (parent.height - 9px) / 2; border-radius: 5px;
                        background: root.status-ok ? #22c55e : #ef4444;
                    }
                    Text { text: root.status-text; color: AppTheme.muted; vertical-alignment: center; font-size: 12px; }
                }
            }
        }

        if root.has-selection: Rectangle {
            width: 330px;
            background: AppTheme.bar;
            border-width: 1px; border-color: AppTheme.border;
            VerticalLayout {
                padding: 14px; spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: root.panel-title; color: root.panel-emergency ? AppTheme.danger : AppTheme.text; font-size: 22px; font-weight: 700; overflow: elide; }
                        Text { text: root.panel-subtitle; color: AppTheme.muted; overflow: elide; }
                    }
                    Button { text: "✕"; clicked => { root.close-panel(); } }
                }
                Switch { text: "Follow aircraft"; checked <=> root.follow; toggled => { root.follow-toggled(self.checked); } }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 7px;
                        for kv in root.panel-rows: HorizontalLayout {
                            spacing: 8px;
                            Text { text: kv.k; color: AppTheme.muted; width: 105px; font-size: 12px; vertical-alignment: top; }
                            Text { text: kv.v; color: AppTheme.text; wrap: word-wrap; horizontal-stretch: 1; font-size: 13px; vertical-alignment: top; }
                        }
                    }
                }
            }
        }
    }

    // settings dialog
    if root.settings-open: Rectangle {
        background: #00000080;
        TouchArea { }
        Panel {
            width: min(620px, parent.width - 40px); height: min(600px, parent.height - 40px);
            background: AppTheme.bar;
            VerticalLayout {
                padding: 18px; spacing: 10px;
                Text { text: "Settings"; color: AppTheme.text; font-size: 20px; font-weight: 700; }
                Field {
                    label: "Poll every " + Math.round(root.s-poll) + " s";
                    Slider { minimum: 2; maximum: 60; value <=> root.s-poll; }
                }
                Field { label: "Units"; ComboBox { model: ["Imperial (ft, kt)", "Metric (m, km/h)"]; current-index <=> root.s-units; } }
                Field { label: "Theme"; ComboBox { model: ["System", "Light", "Dark", "Midnight", "Sepia", "High contrast"]; current-index <=> root.s-theme; } }
                Field { label: "Data source"; ComboBox { model: ["Automatic (adsb.lol, adsb.fi)", "adsb.lol", "adsb.fi", "OpenSky"]; current-index <=> root.s-source; } }
                Field {
                    label: root.s-preload < 5 ? "Preload: off" : "Preload " + Math.round(root.s-preload / 10) * 10 + " nm";
                    Slider { minimum: 0; maximum: 250; value <=> root.s-preload; }
                }
                Field { label: "Zoomed-in refresh"; Switch { text: "Faster when zoomed in (down to 2 s)"; checked <=> root.s-adaptive; } }
                Text {
                    text: "Preload fills the map on start and keeps planes around the view (refreshed every 30 s). Off = only the visible area is loaded.";
                    color: AppTheme.muted; font-size: 11px; wrap: word-wrap;
                }
                Field { label: "OpenSky fallback"; Switch { text: "Enable (non-commercial, credit-limited)"; checked <=> root.s-opensky; } }
                Field { label: "Tile URL"; LineEdit { text <=> root.s-tile-url; } }
                Field {
                    label: "Home (lat, lon)";
                    LineEdit { text <=> root.s-lat; }
                    LineEdit { text <=> root.s-lon; }
                    Button { text: "Use map centre"; clicked => { root.use-center(); } }
                }
                Text { text: root.s-error; color: AppTheme.danger; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.settings-open = false; } }
                    Button { text: "Save"; primary: true; clicked => { root.save-settings(); } }
                }
            }
        }
    }
}
